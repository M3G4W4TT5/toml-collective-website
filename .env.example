# TOML preview configuration. Use PUBLIC_SITE_MODE=demo with an empty Sanity ID
# for the account-free template demonstration.
PUBLIC_SITE_MODE=review
PUBLIC_SITE_LANGUAGE=en
PUBLIC_SANITY_PROJECT_ID=tt800xj0
PUBLIC_SANITY_DATASET=production
SITE_URL=https://toml-collective-website-preview.toml-collective.workers.dev
# Other Workers Builds branches always render with noindex.
SITE_PRODUCTION_BRANCH=main

# Public values embedded in the static site. Keep disabled until hosted inbox receipt is verified.
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_CONTACT_FORM_READY=0
PUBLIC_CONTACT_EMAIL=
