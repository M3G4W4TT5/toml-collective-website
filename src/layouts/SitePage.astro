---
import BaseLayout from "./BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import assets from "../data/deck-assets.json";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  variant?: "default" | "home";
}
const {
  title,
  variant = "default",
  description = "The collective of visual storytellers. A creative collective making brands, campaigns, films and digital experiences.",
  image = assets["p1-h796408d6f171eb9c_0_18"].src,
} = Astro.props;
---

<BaseLayout
  title={`${title} | TOML Collective`}
  description={description}
  image={image}
>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <SiteHeader />
  <main id="main">
    <slot />
  </main>
  <SiteFooter variant={variant} />
</BaseLayout>
