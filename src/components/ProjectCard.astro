---
import { imageSizes } from "../lib/responsive-images";
import ResponsiveImage from "./ResponsiveImage.astro";
import type { Project } from "../data/website";
interface Props {
  project: Project;
  variant?: "default" | "selected" | "compact" | "related";
}
const { project: p, variant = "default" } = Astro.props;
const home = variant === "selected" || variant === "compact";
---

<article
  class:list={["project-card", `project-card--${variant}`]}
  data-filter-item
  data-categories={JSON.stringify(p.categories)}
>
  {p.image && (
    <a
      href={`/work/${p.slug}`}
      class="image-link"
      aria-label={`View ${p.title} case study`}
    >
      <ResponsiveImage
        sizes={imageSizes.half}
        src={p.image}
        alt={p.imageAlt || `${p.title} — ${p.discipline}`}
        width="1200"
        height="900"
        loading="lazy"
      />
    </a>
  )}
  <div class="card-heading">
    <h3>
      <a href={`/work/${p.slug}`}>{p.title}</a>
    </h3>
    {!home && (
      <a class="text-link" href={`/work/${p.slug}`}>
        View case study
      </a>
    )}
  </div>
  {home && <p>{p.summary}</p>}
  <p class:list={{ category: home }}>
    {p.slug === "ubs-red-thread" ? "Art direction / With UNIT9" : p.discipline}
  </p>
</article>
