---
import ResponsiveImage from "../ResponsiveImage.astro";
import type { Project } from "../../data/website";
interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="landing-project" data-landing-reveal>
  <a
    href={`/work/${project.slug}`}
    aria-label={`View ${project.title} case study`}
  >
    <ResponsiveImage
      src={project.image}
      alt={project.imageAlt || `${project.title} — ${project.discipline}`}
      width="1440"
      height="607"
      sizes="(min-width: 48rem) 100vw, calc(100vw - 2.5rem)"
      loading="lazy"
    />
    <div class="landing-project-caption">
      <h3>{project.title}</h3>
      <p>{project.discipline}</p>
    </div>
  </a>
</article>
