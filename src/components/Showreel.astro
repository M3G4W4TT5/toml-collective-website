---
import ResponsiveImage from "./ResponsiveImage.astro";
import { asset } from "../data/website";
interface Props {
  variant?: "link" | "feature";
  id?: string;
}
const { variant = "link", id = "showreel" } = Astro.props;
---

{variant === "link" ? (
  <button
    class="link-button reel-link"
    data-open-dialog={id}
    aria-haspopup="dialog"
  >
    Watch the reel
  </button>
) : (
  <figure class="showreel-feature">
    <>
      <ResponsiveImage
        src={asset("p2-p2_i132")}
        width="1280"
        height="640"
        alt="Floating architectural worlds — TOML showreel still"
        loading="lazy"
      />
      <button class="pill" data-open-dialog={id} aria-haspopup="dialog">
        Play our showreel
        <span class="plus" aria-hidden="true">
          +
        </span>
      </button>
    </>
  </figure>
)}
<dialog
  data-dialog
  class="reel-dialog"
  id={id}
  aria-label="TOML Collective showreel"
>
  <button
    data-close-dialog
    class="close-reel"
    autofocus
    aria-label="Close showreel"
  >
    Close ×
  </button>
  <video controls playsinline preload="none" poster={asset("p2-p2_i132")}>
    <source src="/media/toml-showreel.mp4" type="video/mp4" />
    <a href="/media/toml-showreel.mp4">Download the TOML showreel</a>
  </video>
  <p>TOML Collective / Showreel</p>
</dialog>
<script>
  import "../scripts/dialogs";
</script>
<style>
  .reel-link {
    font-size: calc(1.125rem * var(--body-scale));
  }
  .reel-dialog {
    border: 0;
    background: var(--ink);
    color: var(--canvas);
    padding: 28px;
    width: min(1200px, calc(100% - 32px));
    max-width: 100%;
    max-height: 95dvh;
  }
  .reel-dialog::backdrop {
    background: var(--reel-backdrop);
  }
  video {
    width: 100%;
    max-height: 75dvh;
    display: block;
  }
  .close-reel {
    display: block;
    margin-left: auto;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    padding: 0 0 22px;
  }
  .reel-dialog p {
    font-size: calc(0.8125rem * var(--body-scale));
    margin: 18px 0 0;
  }
  .showreel-feature {
    position: relative;
  }
  .showreel-feature > img {
    aspect-ratio: 2;
    object-fit: cover;
  }
  .showreel-feature > button {
    position: absolute;
    bottom: 32px;
    left: 32px;
  }
  .showreel-feature > button.pill {
    min-width: 260px;
    font-size: calc(1.0625rem * var(--body-scale));
  }
  @media (max-width: 560px) {
    .showreel-feature > button {
      bottom: 16px;
      left: 16px;
      min-height: 48px;
    }
    .showreel-feature > button.pill {
      min-width: 220px;
      font-size: calc(0.875rem * var(--body-scale));
    }
    .showreel-feature > img {
      aspect-ratio: 1.4;
    }
    .reel-dialog {
      padding: 18px;
    }
    .reel-link {
      font-size: calc(1rem * var(--body-scale));
    }
  }
</style>
