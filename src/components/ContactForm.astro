---
import { site } from "../lib/site";
import { enquiryTypes } from "../data/website";
interface Props {
  id?: string;
}
const { id = "contact-form" } = Astro.props;
const { formReady, turnstileSiteKey: siteKey } = site;
---

{
  formReady && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}
<form
  id={id}
  class="enquiry-form"
  data-contact-form
  data-ready={String(formReady)}
  action="/api/contact"
  method="post"
  novalidate
  aria-describedby={`${id}-status`}
>
  <div class="form-two">
    <label for={`${id}-name`}
      >Your name *<input
        id={`${id}-name`}
        name="name"
        autocomplete="name"
        required
        minlength="2"
        maxlength="100"
      /><span class="field-error" data-error-for="name"></span></label
    ><label for={`${id}-email`}
      >Your email *<input
        id={`${id}-email`}
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="200"
      /><span class="field-error" data-error-for="email"></span></label>
  </div>
  <label for={`${id}-company`}
    >Company or organisation (optional)<input
      id={`${id}-company`}
      name="company"
      autocomplete="organization"
      maxlength="200"
    /></label
  >
  <label for={`${id}-type`}
    >What brings you here? *<select
      id={`${id}-type`}
      name="enquiryType"
      required
      ><option value="">Choose an enquiry type</option>{
        enquiryTypes.map((t) => <option value={t}>{t}</option>)
      }</select
    ><span class="field-error" data-error-for="enquiryType"></span></label
  >
  <label for={`${id}-message`}
    >What do you have in mind? *<span class="field-hint"
      >Tell us about the idea, what you need and any timing.<br />If you’re a
      creative, share a link to your work.</span
    ><textarea
      id={`${id}-message`}
      name="message"
      required
      minlength="10"
      maxlength="4000"
      rows="7"></textarea><span class="field-error" data-error-for="message"
    ></span></label
  >
  <label for={`${id}-timing`}
    >When are you hoping to start? (optional)<input
      id={`${id}-timing`}
      name="timing"
      maxlength="200"
    /></label
  >
  <div class="trap" aria-hidden="true">
    <label
      >Website<input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  {
    formReady && (
      <div id={`${id}-turnstile`} class="cf-turnstile" data-sitekey={siteKey} />
    )
  }
  <button class="pill" type="submit"
    ><span>Send enquiry</span><span class="plus" aria-hidden="true">+</span
    ></button
  ><p class="privacy-note">
    We’ll use your details to respond to this enquiry.<br /><a
      class="text-link"
      href="/privacy-policy">Read our Privacy Policy</a>
  </p><p id={`${id}-status`} data-form-status role="status" aria-live="polite">
    {
      formReady
        ? ""
        : "To send an enquiry during this preview, email hello@tomlcollective.com."
    }
  </p>
</form>
<script>
  for (const form of document.querySelectorAll<HTMLFormElement>(
    "[data-contact-form]",
  )) {
    const params = new URLSearchParams(location.search);
    const type = form.elements.namedItem("enquiryType") as HTMLSelectElement;
    const message = form.elements.namedItem("message") as HTMLTextAreaElement;
    const queryType = params.get("type");
    if (
      queryType &&
      Array.from(type.options).some((o) => o.value === queryType)
    )
      type.value = queryType;
    const member = params.get("member");
    if (member && !message.value)
      message.value = `I’d like to discuss a project with ${member.slice(0, 200)}.\n\n`;
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const errors: Record<string, string> = {
      name: "Please add your name.",
      email: "Enter a valid email address.",
      enquiryType: "Choose an enquiry type.",
      message: "Tell us a little about what you have in mind.",
    };
    for (const [name] of Object.entries(errors)) {
      const input = form.elements.namedItem(name) as
        | HTMLInputElement
        | HTMLSelectElement
        | HTMLTextAreaElement;
      const error = form.querySelector<HTMLElement>(
        `[data-error-for="${name}"]`,
      );
      if (error) {
        error.id = `${form.id}-${name}-error`;
        input.setAttribute("aria-describedby", error.id);
      }
      input.addEventListener("input", () => {
        input.removeAttribute("aria-invalid");
        if (error) error.textContent = "";
      });
    }
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      let first: HTMLElement | null = null;
      for (const [name, text] of Object.entries(errors)) {
        const input = form.elements.namedItem(name) as HTMLInputElement;
        const valid = input.checkValidity() && input.value.trim().length > 0;
        const error = form.querySelector<HTMLElement>(
          `[data-error-for="${name}"]`,
        );
        if (error) error.textContent = valid ? "" : text;
        input.setAttribute("aria-invalid", String(!valid));
        if (!valid && !first) first = input;
      }
      if (first) {
        first.focus();
        return;
      }
      if (!status) return;
      if (form.dataset.ready !== "true") {
        status.textContent =
          "Please email hello@tomlcollective.com to send your enquiry. Your message has not been sent.";
        return;
      }
      const button = form.querySelector<HTMLButtonElement>("[type=submit]");
      if (button) button.disabled = true;
      status.textContent = "Sending…";
      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
        });
        const result = (await response.json()) as {
          ok?: boolean;
          mode?: string;
        };
        if (!response.ok || result.ok !== true) throw new Error("Not accepted");
        form.reset();
        status.textContent =
          result.mode === "local_mock"
            ? "Local preview complete. No email was sent."
            : "Thanks for the introduction. We’ve received your message and will be in touch.";
      } catch {
        status.textContent =
          "That didn’t send. Please try again, or email hello@tomlcollective.com.";
      } finally {
        if (button) button.disabled = false;
        const widget = form.querySelector<HTMLElement>(".cf-turnstile");
        if (widget)
          (
            window as Window & {
              turnstile?: { reset: (selector: string) => void };
            }
          ).turnstile?.reset(`#${CSS.escape(widget.id)}`);
      }
    });
  }
</script>
<style>
  .enquiry-form {
    display: grid;
    gap: 44px;
  }
  .form-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
  }
  .enquiry-form label {
    display: grid;
    gap: 22px;
    font-size: 16px;
    line-height: 1.4;
  }
  .enquiry-form input,
  .enquiry-form select {
    border: 0;
    border-bottom: 1px solid var(--rule);
    background: transparent;
    border-radius: 0;
    min-width: 0;
    width: 100%;
    padding: 10px 0 20px;
    font-size: 20px;
  }
  .enquiry-form select {
    color: var(--muted);
  }
  .enquiry-form textarea {
    width: 100%;
    resize: vertical;
    background: transparent;
    border: 1px solid var(--rule);
    padding: 18px;
    min-height: 270px;
    line-height: 1.5;
    font-size: 20px;
    border-radius: 0;
  }
  .field-hint {
    font-size: 16px;
    color: var(--muted);
  }
  .field-error {
    font-size: 14px;
    color: #a3220d;
  }
  .field-error:empty {
    display: none;
  }
  .enquiry-form .pill {
    width: 100%;
    margin-top: 5px;
  }
  .privacy-note,
  [data-form-status] {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
    margin: 0;
  }
  .privacy-note .text-link {
    font-size: 14px;
    margin-top: 8px;
  }
  .trap {
    position: absolute;
    left: -9999px;
  }
  .enquiry-form [aria-invalid="true"] {
    border-color: #a3220d;
  }
  @media (max-width: 560px) {
    .enquiry-form {
      gap: 32px;
    }
    .form-two {
      gap: 22px;
    }
    .enquiry-form label {
      font-size: 14px;
    }
    .enquiry-form input,
    .enquiry-form select,
    .enquiry-form textarea {
      font-size: 18px;
    }
    .enquiry-form textarea {
      min-height: 230px;
    }
  }
</style>
