---
interface Props {
  categories: string[];
  count: number;
  kind: "work" | "members";
}
const { categories, count, kind } = Astro.props;
---

<div
  class="filters"
  role="group"
  aria-label={`Filter ${kind}`}
  data-filters={kind}
>
  {["All", ...categories].map((c, i) => (
    <button
      type="button"
      data-filter={c}
      aria-pressed={i === 0 ? "true" : "false"}
    >
      {c}
    </button>
  ))}
  <span class="count" aria-live="polite" data-filter-count>
    {String(count).padStart(2, "0")}
    {kind === "work" ? "selected projects" : "members"}
  </span>
</div>
<script>
  import "../scripts/filters";
</script>
