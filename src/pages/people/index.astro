---
import "../../styles/pages/people.css";
import SitePage from "../../layouts/SitePage.astro";
import PersonCard from "../../components/PersonCard.astro";
import ContactBand from "../../components/ContactBand.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { team, selectedProjects } from "../../data/website";
---

<SitePage title="The people behind the work">
  <section class="page-intro split people-intro container">
    <div>
      <p class="eyebrow">The people / Core team</p>
      <h1>
        The people
        <br />
        behind the work.
      </h1>
      <a class="text-link" href="/about/approach">
        See our approach
      </a>
    </div>
    <p class="lead intro-copy">
      The people who lead the work and keep the wider collective connected.
      Creative direction, strategy and production, with people close to the
      decisions.
    </p>
  </section>
  <div class="people-grid container rule">
    {team.map((p) => (
      <PersonCard person={p} />
    ))}
  </div>
  <section class="wider-circle container">
    <h2>
      There’s a<br />
      wider circle.
    </h2>
    <p class="lead">
      Meet the independent creatives who bring their own perspective and craft
      to TOML projects.
    </p>
    <a class="text-link" href="/people/members">
      Explore the collective
    </a>
  </section>
  <section class="container section rule team-work">
    <p class="eyebrow">The thinking and the making</p>
    <div class="split">
      <div>
        <h2>
          See what
          <br />
          comes together.
        </h2>
        <p class="lead team-work-copy">
          Explore the ideas, decisions and craft behind our brands, campaigns
          and digital experiences.
        </p>
        <a class="text-link" href="/work">
          Explore our work
        </a>
      </div>
      <div class="grid-2">
        {selectedProjects.slice(0, 2).map((p) => (
          <ProjectCard project={p} variant="compact" />
        ))}
      </div>
    </div>
  </section>
  <ContactBand
    heading={"A team for\nyour next idea."}
    copy="Let’s talk about what you’re planning."
  />
</SitePage>
