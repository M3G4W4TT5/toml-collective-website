---
import SitePage from "../../layouts/SitePage.astro";
import Pill from "../../components/Pill.astro";
import ContactBand from "../../components/ContactBand.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { team, selectedProjects, enquire } from "../../data/website";
---

<SitePage title="The people behind the work"
  ><section class="page-intro split people-intro container">
    <div>
      <p class="eyebrow">The people / Core team</p><h1>
        The people<br />behind the work.
      </h1><a class="text-link" href="/about/approach">See our approach</a>
    </div><p class="lead intro-copy">
      The people who lead the work and keep the wider collective connected.
      Creative direction, strategy and production, with people close to the
      decisions.
    </p>
  </section>
  <div class="people-grid container rule">
    {
      team.map((p) => (
        <article class="person-card">
          {p.image ? (
            <img
              src={p.image}
              width="600"
              height="600"
              alt={p.name}
              loading="lazy"
            />
          ) : (
            <div
              class="initials"
              role="img"
              aria-label={`${p.name} — portrait to come`}
            >
              {p.initials}
            </div>
          )}
          <h3>{p.name.toUpperCase()}</h3>
          <>
            <p>{p.role}</p>
            <button
              class="link-button"
              data-open-profile={p.name.toLowerCase()}
              aria-haspopup="dialog"
            >
              Meet {p.name}
            </button>
            <dialog
              class="profile-dialog"
              id={`profile-${p.name.toLowerCase()}`}
              aria-labelledby={`name-${p.name.toLowerCase()}`}
            >
              <button
                class="close-dialog"
                autofocus
                aria-label={`Close ${p.name}’s profile`}
              >
                Close ×
              </button>
              {p.image && (
                <img src={p.image} width="600" height="600" alt={p.name} />
              )}
              <p class="eyebrow">Core team</p>
              <>
                <h2 id={`name-${p.name.toLowerCase()}`}>{p.name}</h2>
                <p class="muted">{p.role}</p>
                <p class="bio">{p.bio}</p>
                <Pill href={enquire("A new project", p.name)}>
                  Talk about a project
                </Pill>
              </>
            </dialog>
          </>
        </article>
      ))
    }
  </div>
  <section class="wider-circle container">
    <h2>There’s a<br />wider circle.</h2><p class="lead">
      Meet the independent creatives who bring their own perspective and craft
      to TOML projects.
    </p><a class="text-link" href="/people/members">Explore the collective</a>
  </section>
  <section class="container section rule team-work">
    <p class="eyebrow">The thinking and the making</p><div class="split">
      <div>
        <h2>See what<br />comes together.</h2><p
          class="lead"
          style="margin-top:30px"
        >
          Explore the ideas, decisions and craft behind our brands, campaigns
          and digital experiences.
        </p><a class="text-link" href="/work">Explore our work</a>
      </div><div class="grid-2">
        {
          selectedProjects
            .slice(0, 2)
            .map((p) => <ProjectCard project={p} home />)
        }
      </div>
    </div>
  </section><ContactBand
    heading={"A team for\nyour next idea."}
    copy="Let’s talk about what you’re planning."
  /></SitePage
>
<script>
  for (const trigger of document.querySelectorAll<HTMLButtonElement>(
    "[data-open-profile]",
  )) {
    const dialog = document.getElementById(
      `profile-${trigger.dataset.openProfile}`,
    ) as HTMLDialogElement | null;
    trigger.addEventListener("click", () => {
      dialog?.showModal();
      document.body.classList.add("scroll-lock");
    });
    dialog
      ?.querySelector(".close-dialog")
      ?.addEventListener("click", () => dialog.close());
    dialog?.addEventListener("click", (e) => {
      if (e.target === dialog) {
        const r = dialog.getBoundingClientRect();
        if (
          e.clientX < r.left ||
          e.clientX > r.right ||
          e.clientY < r.top ||
          e.clientY > r.bottom
        )
          dialog.close();
      }
    });
    dialog?.addEventListener("close", () => {
      document.body.classList.remove("scroll-lock");
      trigger.focus();
    });
  }
</script>
