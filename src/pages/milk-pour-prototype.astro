---
import BaseLayout from "../layouts/BaseLayout.astro";
import MilkPourPrototype from "../components/milk-pour/MilkPourPrototype";
import carton from "../assets/milk-pour/carton-approved.svg?url";
import "../styles/pages/milk-pour-prototype.css";
---

<BaseLayout
  title="Milk pour prototype — TOML Collective"
  description="An isolated TOML milk-pour motion study."
  noindex
>
  <script slot="head" is:inline>
    // Route-local early cover. Both timeout and CSS fail open if hydration fails.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.setAttribute("data-milk-boot", "");
      const reveal = () =>
        document.documentElement.removeAttribute("data-milk-boot");
      const watchdog = window.setTimeout(reveal, 6000);
      document.addEventListener(
        "milk-pour:ready",
        () => {
          window.clearTimeout(watchdog);
          reveal();
        },
        { once: true },
      );
    }
  </script>
  <MilkPourPrototype client:load />
  <div class="milk-boot" aria-hidden="true">
    <img src={carton} alt="" />
  </div>
</BaseLayout>
