---
import { getHomeContent } from '../lib/content';
import SitePage from '../layouts/SitePage.astro';
const content = await getHomeContent();
---
<SitePage title={content.title} description={content.intro}>
  <p>{content.intro}</p>
  <h2>{content.detailsTitle}</h2>
  <p>{content.details}</p>
</SitePage>
